<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SSH Console"
        Height="620"
        Width="980">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                Margin="0,0,0,10"
                BorderThickness="1"
                BorderBrush="#D9D9D9"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="IP-адрес" />
                <TextBox x:Name="HostTextBox" Grid.Column="1" Text="127.0.0.1" Margin="0,0,14,0" VerticalContentAlignment="Center" />

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0" Text="Порт" />
                <TextBox x:Name="PortTextBox" Grid.Column="3" Text="22" Margin="0,0,14,0" VerticalContentAlignment="Center" />

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0" Text="Пользователь" />
                <TextBox x:Name="UsernameTextBox" Grid.Column="5" Margin="0,0,14,0" VerticalContentAlignment="Center" />

                <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="0,0,8,0" Text="Пароль" />
                <PasswordBox x:Name="PasswordBox" Grid.Column="7" Margin="0,0,14,0" VerticalContentAlignment="Center" />

                <Button x:Name="ConnectButton"
                        Grid.Column="8"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Content="Подключиться"
                        Click="ConnectButton_Click" />
                <Button x:Name="DisconnectButton"
                        Grid.Column="9"
                        Padding="14,6"
                        Content="Отключиться"
                        Click="DisconnectButton_Click" />

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="10"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#2F6BDE"
                           Text="Отключено" />
            </Grid>
        </Border>

        <TextBox x:Name="TerminalOutputTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13"
                 Background="#101319"
                 Foreground="#E6E6E6"
                 BorderBrush="#2A2F3A"
                 BorderThickness="1"
                 Padding="10" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="CommandTextBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     FontFamily="Consolas"
                     FontSize="13"
                     KeyDown="CommandTextBox_KeyDown" />
            <Button x:Name="SendCommandButton"
                    Grid.Column="1"
                    Padding="14,6"
                    Content="Отправить"
                    Click="SendCommandButton_Click" />
        </Grid>
    </Grid>
</Window>
